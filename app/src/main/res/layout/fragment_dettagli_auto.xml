<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Blu_chiaro2"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Card Dettagli -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvDatiUtente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/Bianco"
            app:cardCornerRadius="40dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/tvDettagli"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dettagli"
                    android:textColor="@color/Nero"
                    android:textSize="28dp"
                    android:layout_marginBottom="12dp"
                    android:textStyle="bold" />

                <!-- Lista campi (Label: Dato) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/marca"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMarcaDato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modello"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvModelloDato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Panda"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/targa"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTargaDato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" AB123CD"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Altri campi esistenti nascosti nel design ma presenti nel codice -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/data_immatricolazione"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDataImmatricolazioneDato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cilindrata"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCilindrataDato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alimentazione"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAlimentazioneDato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/libbretto"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLibbrettoDato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/identificativo_veicolo"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvIdentificatoreMotoreDato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/potenza"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPotenzaDato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stato"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatoDato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grigio_medio"
                        android:textSize="18dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Riga KM e Bottone Aggiorna -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:id="@+id/llKm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chilometraggio"
                            android:textColor="@color/Nero"
                            android:textSize="20dp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvChilometraggioDato"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/grigio_medio"
                            android:textSize="20dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnAggiorna"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/Blu_chiaro"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:text="@string/aggiorna"
                        android:textAllCaps="false"
                        android:textSize="14dp"
                        android:textStyle="bold"
                        app:cornerRadius="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card Documentazione -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvDocumenti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/Bianco"
            app:cardCornerRadius="40dp"
            app:layout_constraintTop_toBottomOf="@id/cvDatiUtente">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/tvDocumenti"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Documentazione"
                    android:textColor="@color/Nero"
                    android:textSize="28dp"
                    android:layout_marginBottom="16dp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scrollbars="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivDoc1"
                            android:layout_width="120dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="12dp"
                            android:background="@color/Blu_chiaro"
                            android:padding="24dp"
                            android:src="@drawable/ic_scanner"
                            app:tint="@color/Bianco" />

                        <ImageView
                            android:id="@+id/ivDoc2"
                            android:layout_width="120dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="12dp"
                            android:background="@color/Blu_chiaro"
                            android:padding="24dp"
                            android:src="@drawable/ic_scanner"
                            app:tint="@color/Bianco" />

                        <ImageView
                            android:id="@+id/ivDoc3"
                            android:layout_width="120dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="12dp"
                            android:background="@color/Blu_chiaro"
                            android:padding="24dp"
                            android:src="@drawable/ic_scanner"
                            app:tint="@color/Bianco" />

                        <ImageView
                            android:id="@+id/ivDoc4"
                            android:layout_width="120dp"
                            android:layout_height="match_parent"
                            android:background="@color/Blu_chiaro"
                            android:padding="24dp"
                            android:src="@drawable/ic_scanner"
                            app:tint="@color/Bianco" />
                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>