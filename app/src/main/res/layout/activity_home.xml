<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Bianco"
    android:id="@+id/clHome">


    <!-- 1. HEADER BLU -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvHeaderProfilo"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="-40dp"
        app:cardBackgroundColor="@color/Blu"
        app:cardCornerRadius="40dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvBenvenuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:gravity="center"
            android:text="Benvenuto utente"
            android:textColor="@color/Bianco"
            android:textSize="30dp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <!-- 2. CARD BIANCA SOVRAPPOSTA (Spostiamo qui il LinearLayout) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvSpeseScadenze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        app:cardCornerRadius="25dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toBottomOf="@id/cvHeaderProfilo"> <!-- Sovrapposizione perfetta -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="65dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/ivIconaSpese"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_spese"
                    app:tint="@color/Blu" />

                <TextView
                    android:id="@+id/tvSpese"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/spese"
                    android:textColor="@color/Nero" />

                <TextView
                    android:id="@+id/tvSpeseValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="29,99€"
                    android:textColor="@color/Blu" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="@color/Grigino" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="65dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/ivIconaScadenze"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_sveglia"
                    app:tint="@color/Verde" />

                <TextView
                    android:id="@+id/tvScadenze"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/scadenze"
                    android:textColor="@color/Nero" />

                <TextView
                    android:id="@+id/tvScadenzeValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/Verde" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvVeicoli"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="@string/i_tuoi_veicoli"
        android:textColor="@color/Nero"
        android:paddingTop="10dp"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvHeaderProfilo" /> <!-- Collegato alla card sopra -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVeicoli"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        tools:listitem="@layout/item_auto"
        app:layout_constraintTop_toBottomOf="@id/tvVeicoli"
        app:layout_constraintBottom_toTopOf="@id/nb" />
    <include
        android:id="@+id/nb"
        layout="@layout/activity_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>