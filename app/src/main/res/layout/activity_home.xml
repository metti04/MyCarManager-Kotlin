<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Bianco">


    <!-- 1. HEADER BLU -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvHeaderProfilo"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="-40dp"
        app:cardBackgroundColor="@color/Blu"
        app:cardCornerRadius="40dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvBenvenuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:gravity="center"
            android:text="Benvenuto utente"
            android:textColor="@color/Bianco"
            android:textSize="30dp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <!-- 2. CARD BIANCA SOVRAPPOSTA (Spostiamo qui il LinearLayout) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/stats_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        app:cardCornerRadius="25dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toBottomOf="@id/cvHeaderProfilo"> <!-- Sovrapposizione perfetta -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Spese\n29,99€"
                android:textColor="@color/Nero" />

            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="#CCCCCC" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Scadenze\n1"
                android:textColor="@color/Nero" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvEsempio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="I tuoi veicoli"
        android:textColor="@color/Nero"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvHeaderProfilo" /> <!-- Collegato alla card sopra -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVeicoli"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        tools:listitem="@layout/item_auto"
        app:layout_constraintTop_toBottomOf="@id/tvEsempio"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav" />
    <include
        android:id="@+id/bottom_nav"
        layout="@layout/activity_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>