<?xml version="1.0" encoding="utf-8"?>
<!-- Contenitore per header -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvHeader"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:layout_marginTop="-40dp"
    app:cardBackgroundColor="@color/Blu"
    app:cardCornerRadius="40dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="50dp">

        <TextView
            android:id="@+id/tvScansioneTitolo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Censisci nuova auto"
            android:textColor="@color/Bianco"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvScansionaBox"
            android:layout_width="140dp"
            android:layout_height="140dp"
            app:cardBackgroundColor="@color/Bianco"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/imScansiona"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    app:srcCompat="@drawable/ic_scanner"
                    app:tint="@color/Nero" />

                <TextView
                    android:id="@+id/tvScansione"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scansiona"
                    android:textColor="@color/Nero"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.cardview.widget.CardView>